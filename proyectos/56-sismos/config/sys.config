%% Configurarion de referencia para rebar3 shell y el release.
%% Los sitios de interes (Baja California) y los umbrales viven aqui;
%% los valores de ejemplo del README usan el mismo formato.
[
 {p56_sismos, [
   %% puerto HTTP del dashboard y la API (8080 esta ocupado por
   %% hello_erlang en el dispositivo; se usa 8081)
   {puerto_http, 8081},

   %% Sitios de interés para el clasificador (nombre, lat, lon)
   {sitios, [
     {<<"Tijuana">>,   32.5144, -117.0382},
     {<<"Mexicali">>,  32.6669, -115.4673},
     {<<"Ensenada">>,  31.8667, -116.6000},
     {<<"Campus ITT">>, 32.5168, -115.4368}
   ]},

   %% Simulador de fuentes (escenario del problema)
   {fuentes_activas, true},
   {fuentes_tasa_ms, 2500}
 ]},
 {kernel, [
   {logger_level, info}
 ]}
].
